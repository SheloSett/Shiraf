// Shiraf — esquema de la base.
//
// CÓMO SE ARMÓ ESTE ARCHIVO. El plan (MIGRACION-A-PRISMA.md, Fase 1) dice de
// generarlo con `prisma db pull` contra Supabase. Eso pide la contraseña de la
// base, que no está en el .env, así que se armó de dos fuentes que sí estaban y
// que juntas dicen lo mismo:
//
//   · scripts/referencia/openapi-supabase.json — el OpenAPI que publica
//     PostgREST. Trae las 15 tablas con sus columnas, tipos y nulabilidad
//     exactos, leídos de la base viva.
//   · supabase/migrations/*.sql — de ahí salen los defaults, los enums, las
//     claves foráneas con su ON DELETE, y los índices únicos, que el OpenAPI no
//     describe.
//
// ⚠️ CUANDO TENGAS LA CONTRASEÑA, CORRÉ `prisma db pull` CONTRA UNA COPIA y
//    compará. Es la única forma de descartar que algo se haya tocado a mano en
//    el SQL Editor y no esté en ninguna migración.
//
// Los nombres de tabla y columna se mantienen en snake_case con @map: el seed
// de la Fase 4 carga los JSON tal como salieron de Supabase, y las tres
// funciones SQL que sobreviven (Fase 3) están escritas contra estos nombres.

generator client {
  provider = "prisma-client-js"

  // ── binaryTargets: YA NO CORRESPONDE, y por eso está comentado ────────────
  //
  // Esto decía:
  //
  //   binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
  //
  // La idea era correcta para Prisma 5 y 6, donde el cliente llevaba un motor
  // de consultas NATIVO —un binario de Rust, distinto por sistema operativo— y
  // había que pedir explícitamente el de cada plataforma donde fuera a correr.
  // De ahí salía también todo el cuidado con musl y con openssl en el
  // Dockerfile.
  //
  // Prisma 7 cambió eso de raíz: el motor pasó a ser un compilador en WASM, que
  // es el mismo archivo en todas las plataformas. Comprobado sobre lo que
  // genera esta versión —`node_modules/.prisma/client/` tiene
  // `query_compiler_fast_bg.wasm` y CERO binarios nativos—, así que declarar
  // binaryTargets no baja nada y sólo confunde a quien lo lea.
  //
  // Lo que sí trajo el cambio es que el WASM arma el SQL pero no habla con la
  // base: eso lo hace ahora un DRIVER ADAPTER, que va en el constructor.
  //
  //   import { PrismaPg } from "@prisma/adapter-pg";
  //   const adapter = new PrismaPg({ connectionString: process.env.DATABASE_URL });
  //   const prisma  = new PrismaClient({ adapter });
  //
  // Sin adapter, `new PrismaClient()` tira "A driver adapter is required to
  // connect to your database". Por eso el proyecto suma @prisma/adapter-pg y
  // pg. Va a hacer falta al escribir src/lib/db.ts, en la Fase 5.
  //
  // ── Decisión pendiente, para cuando se escriba código de la app ───────────
  // `prisma-client-js` es el generador viejo: escribe en node_modules y en 7
  // quedó como legado. El nuevo es `prisma-client`, con un `output` explícito
  // dentro de src/, y tiene una ventaja concreta acá: si el cliente vive en
  // src/, lo empaqueta Nitro y la imagen de producción no necesita copiar nada
  // de node_modules. Se deja el viejo por ahora porque funciona y está
  // verificado; cambiarlo es una decisión de la Fase 5, no de este arreglo.
}

datasource db {
  provider = "postgresql"

  // La URL se mudó a prisma.config.ts, en la raíz del proyecto.
  //
  // Prisma 7 ya no acepta `url` acá: la validación falla con P1012, "The
  // datasource property `url` is no longer supported in schema files". Se deja
  // comentada para que quede claro que no es un olvido y de dónde salió.
  //
  // url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

// 'staff' se agregó después (20260813060000) y va al final a propósito: así
// queda en el mismo orden que en la base, donde ADD VALUE lo puso último.
enum app_role {
  admin

  /**
   * ⚠️ NO AUTORIZA NADA. Está en el enum desde Supabase y no lo lee ningún
   * `if` del servidor: quién atiende sale de `professionals.user_id`, que es lo
   * que `accesoDe` mira para habilitar «Mi agenda». Se deja porque sacar un
   * valor de un enum en Postgres pide recrear el tipo entero, y no vale el
   * riesgo por un valor que no molesta. No lo uses para decidir accesos.
   */
  professional

  /**
   * Tampoco autoriza por sí solo: lo que habilita es cada user_permissions.
   */
  client
  staff
}

enum app_permission {
  appointments // gestionar turnos (ver todos, confirmar, cargar, cancelar)
  clients_contact // ver la ficha y el teléfono de las clientas
  clients_notes // RETIRADO el 27/8/2026: se absorbió en clients_contact. El
  // valor se deja porque sacarlo de un enum de Postgres es una
  // migración pesada que no gana nada, y las filas que lo
  // tenían ya se migraron. No lo pregunta nadie: ver PERMISSIONS.
  catalog // editar tratamientos, precios y categorías
  stock // mover stock y editar productos
  stock_costs // ver los costos de compra
  team // gestionar profesionales, sus horarios y tratamientos
  metrics // ver el Dashboard y las Métricas del negocio (28/8/2026)
}

enum appointment_status {
  pending
  confirmed
  completed
  cancelled
}

enum media_kind {
  image
  video
}

// ─────────────────────────────────────────────────────────────────────────────
// Cuentas
// ─────────────────────────────────────────────────────────────────────────────

// Reemplaza a auth.users de Supabase. Guarda SÓLO lo de autenticación: la ficha
// de la persona sigue viviendo en profiles, y los accesos en user_roles y
// user_permissions, que no se tocan.
//
// La forma es la de Ecommerce_mm (model Customer): mail, contraseña bcrypt, y
// los pares token/vencimiento.
model users {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email    String @unique
  password String // bcrypt

  // Recuperar contraseña. Copiado tal cual del ecommerce: 32 bytes hex, una
  // hora de vida, un solo uso, se limpian los dos campos al usarlo.
  reset_token        String?   @unique
  reset_token_expiry DateTime? @db.Timestamptz(6)

  // Confirmación de mail. Esto el ecommerce no lo tiene y Shiraf lo necesita:
  // al confirmar se le pasan a la clienta los turnos que sacó como invitada,
  // buscándolos POR MAIL. Sin verificar, cualquiera se registra con el mail de
  // otra y le ve los turnos. Ver MIGRACION-A-PRISMA.md, sección 2.
  verify_token        String?   @unique
  verify_token_expiry DateTime? @db.Timestamptz(6)
  email_verified_at   DateTime? @db.Timestamptz(6)

  /**
   * La cuenta puede entrar.
   * Es la baja SIN borrar: la empleada que se va de licencia, la que dejó de
   * trabajar pero cuyo historial se quiere conservar, la cuenta que hay que
   * cerrar de urgencia un domingo. Borrarla era lo único que había, y borrar es
   * definitivo.
   * Se mira en `authMiddleware`, en cada pedido con sesión, no sólo al entrar:
   * el token dura 7 días, así que si sólo se mirara en el login una cuenta
   * suspendida seguiría trabajando una semana. Es el mismo razonamiento por el
   * que los permisos tampoco viajan adentro del token.
   */
  is_active Boolean @default(true)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  profile         profiles?
  roles           user_roles[]
  permissions     user_permissions[]
  appointments    appointments[]
  professional    professionals?
  client_note     client_notes?
  stock_movements stock_movements[]
}

// La ficha de la clienta. NO tiene el mail y es deliberado: vive en users, y
// esta tabla la lee cualquiera con 'clients_contact' o con 'appointments'.
// Ver MIGRACION-A-PRISMA.md, trampa #3.
model profiles {
  id         String    @id @db.Uuid
  full_name  String?
  phone      String?
  birth_date DateTime? @db.Date
  notes      String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user users @relation(fields: [id], references: [id], onDelete: Cascade)
}

model user_roles {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  role       app_role
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role])
}

model user_permissions {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String         @db.Uuid
  permission app_permission
  created_at DateTime       @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, permission])
}

// Las notas clínicas: alergias, embarazos. Tabla aparte de profiles a propósito
// (20260814010000), para poder pedir un permiso distinto —'clients_notes'— sin
// dar acceso al resto de la ficha.
model client_notes {
  client_id  String   @id @db.Uuid
  body       String?
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user users @relation(fields: [client_id], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// Catálogo
// ─────────────────────────────────────────────────────────────────────────────

// ⚠️ services.category es TEXTO, no una FK a service_categories. Está así en la
// base y se deja igual: cambiarlo es una migración de datos, no parte de este
// traslado. El renombrado atómico de una categoría lo resuelve
// rename_service_category (20260816000000), que actualiza las dos tablas juntas.
model services {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  // La parte legible de la URL: /servicios/drenaje-linfatico en vez de
  // /servicios/11111111-1111-4111-8111-111111111104.
  //
  // La escribe el servidor a partir del nombre y SE REGENERA cuando el nombre
  // cambia: renombrar el tratamiento cambia su URL. La vieja no queda
  // redirigida —eso pediría una tabla de URLs viejas, que para seis
  // tratamientos no se justifica— pero tampoco deja a nadie tirado: la ficha
  // sigue aceptando el UUID, que no cambia nunca.
  //
  // ── POR QUÉ ES OPCIONAL Y NO `String @unique` A SECAS ─────────────────────
  //
  // Por dos motivos, y los dos importan:
  //
  // 1. `prisma db push` no puede agregar una columna NOT NULL y unica a una
  //    tabla que ya tiene filas: no hay valor que ponerles. Nula entra sin
  //    drama y `scripts/rellenar-slugs.ts` la completa después.
  // 2. Deja que una fila entre por fuera de la app —el seed, un INSERT a mano,
  //    un import— sin quedar rota. El código cae al UUID cuando el slug no
  //    está, así que una ficha sin slug se ve fea en la barra pero anda.
  slug             String? @unique
  description      String?
  category         String  @default("General")
  duration_minutes Int     @default(60)
  // Los minutos de limpieza que este tratamiento pide DESPUÉS, antes de que
  // entre la clienta siguiente.
  //
  // Era `SLOT_BUFFER_MINUTES`, un 10 fijo para todo el catálogo. Dejó de
  // alcanzar: una depilación deja la cabina para limpiar y un masaje no, y con
  // un solo número o se le regala tiempo a uno o se le queda corto al otro.
  //
  // ── MANDA EL TRATAMIENTO QUE TERMINA ─────────────────────────────────────
  //
  // Entre dos turnos seguidos el margen lo pone el de ATRÁS, porque el rato es
  // para limpiar lo que ése acaba de usar: una depilación de 20 seguida de un
  // masaje deja 20, y el masaje de 5 seguido de una depilación deja 5. Lo
  // implementa `buildSlots`.
  //
  // El default de 10 es el número que el centro había definido el 18/8/2026
  // para todo el catálogo, así que ningún tratamiento cambia de comportamiento
  // porque esta columna aparezca.
  buffer_minutes   Int     @default(10)
  price            Decimal @default(0) @db.Decimal(12, 2)

  /**
   * Cuántas sesiones son, y cada cuántos días.
   * Hay tratamientos que no se terminan en una visita: son tres sesiones cada
   * veintiún días, y la clienta tiene que saberlo ANTES de reservar. Con 1 —el
   * default, y el caso de casi todo el catálogo— nada de esto se muestra ni
   * cambia nada.
   * ── LA PLATA ES DEL PAQUETE, NO DE CADA SESIÓN ──────────────────────────
   * `price` sigue siendo UN precio y es el del tratamiento completo. Se cobra
   * una vez: `validarTurno` lo congela en la PRIMERA sesión y les pone 0 a las
   * siguientes. Sin eso, las métricas contarían la misma venta tres veces —y
   * ése es el error que no se nota, porque cada turno mirado de a uno se ve
   * bien.
   * ── EL INTERVALO NO ES UNA REJA ─────────────────────────────────────────
   * La clienta reserva SÓLO la primera sesión; las que siguen las agenda el
   * centro cuando ella viene. Así que estos días son con lo que el panel
   * propone la fecha de la próxima, no un candado sobre el calendario: si la
   * clienta se va de viaje, la sesión 2 va cuando se pueda y el turno se carga
   * igual.
   * 0 días es legítimo y quiere decir "sin espera sugerida".
   */
  sessions_count        Int @default(1)
  session_interval_days Int @default(0)

  // La mantiene el trigger sync_service_cover, igualada a la primera foto de la
  // galería. No la escribas a mano ni la seedees. Ver Fase 3.
  image_url    String?
  is_published Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  media                 service_media[]
  variants              service_variants[]
  professional_services professional_services[]
  appointments          appointments[]
}

model service_categories {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

/**
 * Las opciones de un mismo tratamiento: "solo espalda" y "cuerpo completo".
 * ── POR QUÉ UNA TABLA Y NO DOS TRATAMIENTOS ──────────────────────────────────
 * Porque es UN tratamiento. Duplicar la ficha duplica la foto, la descripción,
 * la categoría, el slug y la lista de profesionales que lo realizan, y las dos
 * copias empiezan a separarse la primera vez que alguien edita una sola. Lo
 * único que cambia entre las opciones es cuánto dura, cuánto sale y cuánto deja
 * para limpiar.
 * ── EL TRATAMIENTO SIGUE TENIENDO PRECIO Y DURACIÓN PROPIOS ──────────────────
 * `services.price` y `services.duration_minutes` no se vacían ni se vuelven
 * opcionales. Son los del tratamiento SIN variantes, que son la enorme mayoría
 * del catálogo, y sacarlos obligaría a crear una variante boba para cada uno.
 * Cuando hay variantes activas, mandan ellas: el catálogo muestra "desde $X" y
 * la reserva exige elegir una. Lo decide `variantesDe()`, un solo lugar.
 * `is_active` en vez de borrar: una opción que se deja de ofrecer tiene turnos
 * viejos apuntando a ella. Apagarla la saca de la reserva y deja el historial
 * en pie.
 */
model service_variants {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_id String @db.Uuid
  // "Solo espalda", "Cuerpo completo". Sin el nombre del tratamiento adentro:
  // se muestra siempre al lado de él.
  name       String

  duration_minutes Int
  // Propio y no heredado del tratamiento: un "cuerpo completo" deja la cabina
  // para limpiar de otra manera que un "solo espalda". El formulario lo
  // arranca con el del tratamiento, así que no cargarlo tampoco es un problema.
  buffer_minutes   Int     @default(10)
  price            Decimal @default(0) @db.Decimal(12, 2)

  // El orden en que se muestran. Lo elige el centro: casi siempre es de la
  // opción más chica a la más grande, que no es ni alfabético ni por precio.
  position   Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  service      services       @relation(fields: [service_id], references: [id], onDelete: Cascade)
  appointments appointments[]

  // Cascade y no SetNull, al revés que en appointments: una variante sin
  // tratamiento no es nada. El historial de turnos no se pierde igual, porque
  // el turno se queda con `variant_name` congelado.

  // Mismo criterio que service_media: sin @@unique([service_id, position]),
  // porque reordenar de a una fila pasa por posiciones repetidas.
  @@index([service_id, position])
}

// Sin @@unique([service_id, position]) a propósito: reordenar de a una fila pasa
// por estados con posiciones repetidas. El orden desempata por created_at.
// El comentario original está en 20260818010000.
model service_media {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_id String     @db.Uuid
  url        String
  kind       media_kind
  position   Int        @default(0)
  created_at DateTime   @default(now()) @db.Timestamptz(6)

  service services @relation(fields: [service_id], references: [id], onDelete: Cascade)

  // Es exactamente el ORDER BY de sync_service_cover, el trigger que mantiene
  // la portada del tratamiento. Estaba en 20260818010000 y se había perdido en
  // el traslado: el trigger se migró y su índice no.
  @@index([service_id, position, created_at])
}

// ─────────────────────────────────────────────────────────────────────────────
// Equipo
// ─────────────────────────────────────────────────────────────────────────────

model professionals {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Atar una ficha a una cuenta lo hace SÓLO la dueña: sin ese candado,
  // cualquiera con el permiso 'team' se apunta una ficha ajena y pasa a leer los
  // teléfonos y las notas de esas clientas. Lo hace cumplir
  // guard_professional_account_link; en la base nueva es código (Fase 5).
  user_id    String?  @unique @db.Uuid
  full_name  String
  specialty  String?
  bio        String?
  avatar_url String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user         users?                   @relation(fields: [user_id], references: [id], onDelete: SetNull)
  services     professional_services[]
  schedules    professional_schedules[]
  absences     professional_absences[]
  appointments appointments[]
}

model professional_services {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  professional_id String @db.Uuid
  service_id      String @db.Uuid

  professional professionals @relation(fields: [professional_id], references: [id], onDelete: Cascade)
  service      services      @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@unique([professional_id, service_id])
}

model professional_schedules {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  professional_id String   @db.Uuid
  weekday         Int
  // TIME sin zona: es hora de pared del centro. La comparación con starts_at,
  // que sí es TIMESTAMPTZ, pasa por America/Argentina/Buenos_Aires. Está
  // explicado en validate_appointment (20260813040000).
  start_time      DateTime @db.Time(6)
  end_time        DateTime @db.Time(6)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  professional professionals @relation(fields: [professional_id], references: [id], onDelete: Cascade)
}

// Los días que una profesional NO está, aunque su horario semanal diga que sí.
//
// `professional_schedules` es una semana que se repite para siempre: dice "los
// martes de 12 a 16" y no sabe decir "menos el martes que viene". Esta tabla es
// esa excepción, y por eso vive al lado.
//
// ── POR QUÉ UN RANGO Y NO UNA FILA POR DÍA ──────────────────────────────────
//
// Porque el caso real son las vacaciones. Con una fila por día, dos semanas son
// catorce filas que hay que cargar de a una y después borrar de a una, y alcanza
// con que se escape una para que quede un agujero raro en el medio. El día
// suelto sigue entrando: es `starts_on` = `ends_on`.
//
// ── LOS DOS EXTREMOS ESTÁN INCLUIDOS ────────────────────────────────────────
//
// Del 15 al 29 son quince días sin trabajar, no catorce: el 29 tampoco está. Es
// la lectura que tiene cualquiera que escriba esas dos fechas en un papel, y la
// que hace `estaAusente()`.
//
// ── DATE Y NO TIMESTAMPTZ ───────────────────────────────────────────────────
//
// Un día de ausencia es un día del almanaque del centro, no un instante: el 15
// de septiembre empieza y termina en Buenos Aires. Es el mismo criterio por el
// que `professional_schedules` guarda TIME sin zona.
model professional_absences {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  professional_id String   @db.Uuid
  starts_on       DateTime @db.Date
  ends_on         DateTime @db.Date
  // Para que la dueña se acuerde de por qué la cargó. Es interna: no sale en
  // ningún mail ni en el sitio público. Opcional a propósito — obligar a
  // escribir algo termina con todo el mundo poniendo "x".
  reason          String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  professional professionals @relation(fields: [professional_id], references: [id], onDelete: Cascade)

  // Las dos consultas que existen son "qué ausencias tiene esta profesional" y
  // "hay alguna que tape este día". Las dos entran por profesional y después por
  // fechas.
  @@index([professional_id, starts_on, ends_on])
}

// ─────────────────────────────────────────────────────────────────────────────
// Turnos
// ─────────────────────────────────────────────────────────────────────────────

model appointments {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // NULL a propósito: son los turnos de invitada, que carga el centro por
  // teléfono para alguien sin cuenta. No es un dato faltante.
  client_id        String?  @db.Uuid
  // NULL cuando el tratamiento se borró del catálogo. El turno viejo sigue
  // existiendo con su nombre y su precio congelados; ver `service_name`.
  service_id       String?  @db.Uuid
  /**
   * Qué opción del tratamiento se reservó, cuando el tratamiento tiene.
   * NULL en la enorme mayoría de los turnos: es un tratamiento sin variantes.
   * También queda NULL si la opción se borra del catálogo — por eso al lado
   * viaja `variant_name`, congelado igual que `service_name` y por el mismo
   * motivo. Un turno de "Masaje" que costó $65.000 no dice lo mismo que uno de
   * "Masaje — cuerpo completo", y el precio congelado solo no lo explica.
   */
  variant_id       String?  @db.Uuid
  professional_id  String?  @db.Uuid
  starts_at        DateTime @db.Timestamptz(6)
  // Lo pisa la base con el del tratamiento: no lo manda el cliente.
  duration_minutes Int      @default(60)
  // El margen de limpieza del tratamiento, congelado igual que el precio.
  //
  // No es prolijidad: `service_id` es nullable a propósito —el turno sobrevive
  // al borrado del tratamiento— y sin esta copia un turno huérfano no tendría
  // de dónde sacar su margen, así que la agenda calcularía mal los huecos que
  // lo rodean. Lo escribe `validarTurno`, nunca quien llama.
  buffer_minutes   Int      @default(10)
  /**
   * Las sesiones de un mismo tratamiento, atadas entre sí.
   * `series_id` es **el id de la PRIMERA sesión**, y por eso la primera lo
   * tiene en NULL: sería apuntarse a sí misma. Se eligió así en vez de un uuid
   * aparte porque no hay que inventar ninguna clave nueva ni generarla antes
   * del INSERT — la serie entera se busca con
   * where: { OR: [{ id: primera }, { series_id: primera }] }
   * `session_number` y `sessions_total` van congelados en el turno, igual que
   * el precio y el nombre: si mañana el tratamiento pasa de 3 sesiones a 4, el
   * turno de la clienta que ya empezó tiene que seguir diciendo "2 de 3", que
   * es lo que ella reservó.
   * En un tratamiento de una sola sesión —casi todo el catálogo— esto es NULL,
   * 1 y 1, y no se muestra en ninguna pantalla.
   */
  series_id        String?  @db.Uuid
  session_number   Int      @default(1)
  sessions_total   Int      @default(1)

  status       appointment_status @default(pending)
  client_notes String?
  admin_notes  String?

  /**
   * Por qué se canceló, escrito por quien lo canceló.
   * ⚠️ **Este texto SE LE MANDA A LA CLIENTA** cuando el centro cancela, así que
   * la pantalla lo dice al pedirlo. No es una nota interna: para eso está
   * `admin_notes`, que no sale de la app.
   * Sirve para los dos lados. Si cancela el centro, es la explicación que la
   * clienta recibe en el mail —"se nos rompió el equipo", "la profesional está
   * enferma"— en vez de un "tuvimos que cancelar" a secas. Si cancela la
   * clienta, es lo que el centro lee en la ficha para saber si perdió una venta
   * por precio, por horario o porque se enfermó.
   * Es opcional a propósito: obligar a escribir algo para poder cancelar un
   * turno es la clase de traba que termina con todo el mundo escribiendo "x".
   */
  cancel_reason     String?
  // Congelado a propósito: es el precio del día que se reservó, no el actual
  // del catálogo. No lo reemplaces por un join a services.price.
  price             Decimal   @db.Decimal(12, 2)
  // El nombre del tratamiento, congelado igual que el precio y por el mismo
  // motivo — y además por uno propio: es lo que deja BORRAR un tratamiento del
  // catálogo sin que el historial quede diciendo "turno de nada". Lo escribe
  // `validarTurno`, nunca quien llama.
  //
  // Opcional sólo por los turnos que existían antes de esta columna; el CHECK
  // `appointments_names_its_service` de reglas.sql exige que haya nombre o
  // service_id, así que un turno sin ninguno de los dos no se puede escribir.
  service_name      String?
  /**
   * La opción elegida, congelada: "Cuerpo completo".
   * Sin CHECK que la ate a `variant_id`, a diferencia de `service_name`: acá
   * NULL es el caso normal —el tratamiento no tiene variantes— y no un dato que
   * falta. Lo escribe `validarTurno`, nunca quien llama.
   */
  variant_name      String?
  // El nombre de la profesional, congelado por el mismo motivo que el del
  // tratamiento: es lo que deja BORRAR una ficha del equipo sin que los turnos
  // que esa persona atendió queden diciendo "sin asignar".
  //
  // Sin esto, borrar una profesional dejaba `professional_id` en NULL (la FK es
  // SetNull) y el historial pasaba a ser indistinguible de un turno que nunca
  // tuvo a nadie. Y peor: la pantalla lo marcaba en rojo pidiendo que se le
  // asignara alguien, cosa que en un turno de hace dos meses sería inventar
  // quién atendió.
  //
  // A diferencia de `service_name`, acá NO hay CHECK que exija uno de los dos:
  // un turno sin profesional y sin nombre es legítimo — es el que el centro
  // carga sin decidir todavía quién atiende.
  professional_name String?
  guest_name        String?
  guest_phone       String?
  guest_email       String?
  reminded_at       DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  client       users?            @relation(fields: [client_id], references: [id], onDelete: Cascade)
  // SetNull y no RESTRICT ni CASCADE.
  //
  // CASCADE nunca: borrar un tratamiento no puede llevarse puesto el historial
  // de turnos que lo usaron. Eso sigue valiendo.
  //
  // Era RESTRICT, y eso hacía que un tratamiento tomado UNA vez en 2024 no se
  // pudiera borrar nunca más. Ahora el vínculo se corta y el turno viejo queda
  // con `service_name` y `price`, que es todo lo que hace falta para leerlo.
  //
  // Que no se pueda borrar un tratamiento CON TURNOS POR VENIR se sigue
  // frenando — pero en el controlador, mirando el estado, que es donde se puede
  // explicar por qué. La base no distingue un turno de mañana de uno del año
  // pasado.
  service      services?         @relation(fields: [service_id], references: [id], onDelete: SetNull)
  // SetNull por lo mismo que `service`: sacar una opción del catálogo no puede
  // llevarse puesto el turno que la usó. Lo que quedó dicho está en
  // `variant_name` y en `price`.
  variant      service_variants? @relation(fields: [variant_id], references: [id], onDelete: SetNull)
  professional professionals?    @relation(fields: [professional_id], references: [id], onDelete: SetNull)

  // Los dos índices que appointments tenía desde la primera migración de
  // Supabase. Hay que declararlos: Prisma NO crea índices sobre las claves
  // foráneas en Postgres —a diferencia de lo que hace en MySQL—, así que sin
  // esto no existirían.
  //
  //   starts_at · el calendario y la agenda, que siempre filtran por fecha
  //   client_id · "mis turnos" de la clienta
  //
  // Los otros cuatro de esta tabla son parciales, y eso Prisma no lo sabe
  // escribir: viven en 20260820000002_indices_parciales.
  @@index([starts_at])
  @@index([client_id])
  // Buscar las sesiones que siguen a una: se pregunta en cada turno de una
  // serie, para saber si ya está agendada la próxima.
  @@index([series_id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Stock
// ─────────────────────────────────────────────────────────────────────────────

// ⚠️ products.category apunta a product_categories por texto, igual que
// services.category. Y ojo con el permiso: product_categories pide 'stock', NO
// 'catalog' — agrupan insumos internos que no salen en el sitio
// (20260814000000). Ver trampa #5.
model products {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  brand      String?
  category   String   @default("Cremas")
  unit       String   @default("unidad")
  // Lo mantiene el trigger apply_stock_movement, sumando cada movimiento dentro
  // de la misma transacción. No lo escribas directo. Ver Fase 3.
  stock      Decimal  @default(0) @db.Decimal(12, 2)
  min_stock  Decimal  @default(0) @db.Decimal(12, 2)
  cost       Decimal? @db.Decimal(12, 2)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  costs     product_costs?
  movements stock_movements[]
}

model product_categories {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

// Los costos de compra, en tabla aparte para poder pedirles el permiso
// 'stock_costs' sin tapar el resto del stock (20260814010000).
model product_costs {
  product_id String   @id @db.Uuid
  cost       Decimal? @db.Decimal(12, 2)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)
}

model stock_movements {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String   @db.Uuid
  quantity   Decimal  @db.Decimal(12, 2)
  reason     String?
  created_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  product products @relation(fields: [product_id], references: [id], onDelete: Cascade)
  author  users?   @relation(fields: [created_by], references: [id], onDelete: SetNull)
}
