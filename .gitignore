# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
# Artefacto del preset `vercel` de Nitro (Build Output API v3). Se genera solo
# al construir con NITRO_PRESET=vercel; Vercel lo produce en su propio runner.
.vercel
*.local

# Vista previa local de los mails. Se genera desde supabase/emails/*.html para
# poder mirarlos en el navegador; vive en public/ sólo porque es la carpeta que
# el dev server sirve tal cual. No tiene por qué publicarse con el sitio.
public/preview-mails/

# Secretos. El .env estuvo trackeado hasta ahora: las claves que tenía son
# publishable (públicas por diseño, viajan igual en el bundle del navegador),
# así que no hubo fuga ni hay nada que rotar. Se saca del repo de forma
# preventiva: el día que se agregue SUPABASE_SERVICE_ROLE_KEY —que sí bypasea
# toda la RLS— se habría commiteado sola. La plantilla vive en .env.example.
.env
.env.*
!.env.example

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Caché de la CLI de Supabase. La crea sola cualquier `npx supabase …` y no
# tiene nada que aporte al repo: guarda la última versión de la CLI y el ref
# del proyecto linkeado.
supabase/.temp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.lovable

# El lockfile del repo es bun.lock. Un package-lock.json generado en Windows
# rompe los builds en Linux por las dependencias opcionales de rollup/esbuild.
package-lock.json

.claude/
